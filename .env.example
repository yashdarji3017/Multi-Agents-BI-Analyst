# ==============================================================================
# BusinessInsight AI - Environment Configuration Example
# Copy this file to .env and provide your Gemini API key.
# ==============================================================================

# Google Gemini API Configuration (Required for AI Agents)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Dataset Configuration
# Default path to the Kaggle Superstore CSV dataset
DATASET_PATH=data/raw/superstore.csv

# Output Directories (Local storage only; no database is used)
REPORT_OUTPUT_DIR=outputs/reports
CHARTS_OUTPUT_DIR=outputs/charts

# Application Runtime Configuration
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_SERVER_PORT=8501

# Workflow Governance
MAX_VERIFICATION_ROUNDS=2
MAX_RECOMMENDATIONS=5
